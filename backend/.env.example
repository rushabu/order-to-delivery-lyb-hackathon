# Copy to .env and fill in. Never commit .env.
# Port the API listens on.
PORT=4000
# Secret used to sign login tokens (HS256). Use a long random string; required.
JWT_SECRET=
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# SQLite database file. Use :memory: for a throwaway database.
DATABASE_FILE=./data/control-tower.sqlite
# true enables the simulated clock, the replay simulator and the /demo endpoints.
DEMO_MODE=true
# Optional. Enables the fictional live-routing shipment on Demo controls.
TOMTOM_API_KEY=
# Optional. Enables the order-tracking assistant (free key from console.groq.com/keys).
GROQ_API_KEY=
# Optional. Groq model id; the default is openai/gpt-oss-120b.
GROQ_MODEL=
