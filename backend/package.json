{
  "name": "control-tower-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for the Order-to-Delivery Control Tower, Problem Statement 3 of the LYB Mumbai Hackathon 2026 (Round 2). All data is fictional.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --use-system-ca --env-file-if-exists=.env src/server.ts",
    "start": "tsx --use-system-ca --env-file-if-exists=.env src/server.ts",
    "seed": "tsx --env-file-if-exists=.env src/sim/seedCli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LYBHackathon/control-tower-api.git"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "better-sqlite3": "^13.1.1",
    "fastify": "^5.12.8",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "better-sqlite3@13.1.1": true,
    "esbuild@0.28.2": true
  }
}
