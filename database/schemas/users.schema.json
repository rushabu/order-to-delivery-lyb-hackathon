{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "users.schema.json",
  "title": "users.json: fictional people with demo passwords for seeding",
  "$ref": "common.schema.json#/$defs/file",
  "required": ["users"],
  "properties": {
    "users": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "email", "password", "role", "phone"],
        "properties": {
          "id": {"type": "string", "pattern": "^USR-(COORD|DRV|CUST)-\\d{2}$"},
          "name": {"type": "string"},
          "email": {"type": "string", "pattern": "^[a-z]+\\.[a-z]+@[a-z]+\\.example$"},
          "password": {"type": "string", "minLength": 12},
          "role": {"enum": ["COORDINATOR", "DRIVER", "CUSTOMER"]},
          "customer_id": {"type": "string"},
          "transporter_id": {"type": "string"},
          "phone": {"type": "string", "pattern": "^\\+91 00000 \\d{5}$"}
        },
        "allOf": [
          {"if": {"properties": {"role": {"const": "CUSTOMER"}}},
           "then": {"required": ["customer_id"], "not": {"required": ["transporter_id"]}}},
          {"if": {"properties": {"role": {"const": "DRIVER"}}},
           "then": {"required": ["transporter_id"], "not": {"required": ["customer_id"]}}},
          {"if": {"properties": {"role": {"const": "COORDINATOR"}}},
           "then": {"not": {"anyOf": [{"required": ["customer_id"]}, {"required": ["transporter_id"]}]}}}
        ]
      }
    }
  },
  "unevaluatedProperties": false
}
