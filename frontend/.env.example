# Base URL of control-tower-api, without the /api/v1 suffix.
VITE_API_URL=http://localhost:4000
# "true" serves every endpoint from the in-browser mock (src/mocks).
# A comma-separated list of path prefixes mocks only those, e.g. "/dashboard,/metrics".
# "false" or empty uses the real API for everything.
VITE_USE_MOCKS=true
# "true" when the API runs with DEMO_MODE=true: shows /coordinator/demo,
# "Position: simulated" on the driver screen, and omits occurred_at on driver events.
VITE_DEMO_MODE=true
